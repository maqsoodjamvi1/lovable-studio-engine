FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git docker.io openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ ./backend/
COPY shared/ ./shared/
COPY scripts/ ./scripts/
ENV WORKSPACE_DIR=/var/platform/workspaces
ENV BACKUP_DIR=/var/platform/backups
WORKDIR /app/backend
EXPOSE 8000
CMD ["uvicorn", "orchestrator:app", "--host", "0.0.0.0", "--port", "8000"]

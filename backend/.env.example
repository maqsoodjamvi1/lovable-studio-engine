# Copy to .env and fill in real values
ANTHROPIC_API_KEY=sk-ant-...

# Paths used by the orchestrator (match Coolify volume mounts)
WORKSPACE_DIR=/var/platform/workspaces
BACKUP_DIR=/var/platform/backups

# Docker container that runs the shared Postgres instance
POSTGRES_CONTAINER=production-postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=platformsecret

# Optional
# PLAYWRIGHT_ENABLED=1
# DEPLOY_WEBHOOK_URL=
# PUBLIC_APPS_BASE=http://localhost:4173
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
